
<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista de lista -->
    <record id="view_prestamo_equipo_list" model="ir.ui.view">
        <field name="name">prestamo.equipo.list</field>
        <field name="model">prestamo.equipo</field>
        <field name="arch" type="xml">
            <list string="Equipos">
                <field name="name"/>
                <field name="codigo"/>
                <field name="categoria"/>
                <field name="estado"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Vista de formulario -->
    <record id="view_prestamo_equipo_form" model="ir.ui.view">
        <field name="name">prestamo.equipo.form</field>
        <field name="model">prestamo.equipo</field>
        <field name="arch" type="xml">
            <form string="Equipo">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"
                                   placeholder="Nombre del equipo"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <field name="codigo"/>
                            <field name="categoria"/>
                        </group>
                        <group>
                            <field name="estado"/>
                            <field name="active"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Notas">
                            <field name="notas"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Vista Kanban -->
    <record id="view_prestamo_equipo_kanban" model="ir.ui.view">
        <field name="name">prestamo.equipo.kanban</field>
        <field name="model">prestamo.equipo</field>
        <field name="arch" type="xml">
            <kanban default_group_by="estado">
                <field name="estado"/>
                <field name="name"/>
                <field name="codigo"/>
                <field name="categoria"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click">
                            <div class="fw-bold">
                                <field name="name"/>
                            </div>
                            <div>
                                <field name="codigo"/>
                            </div>
                            <div>
                                <field name="categoria"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Acción de equipos -->
    <record id="action_prestamo_equipo" model="ir.actions.act_window">
        <field name="name">Equipos</field>
        <field name="res_model">prestamo.equipo</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="view_id" ref="view_prestamo_equipo_kanban"/>
    </record>

    <!-- Menú principal -->
    <menuitem id="menu_prestamo_root"
              name="Préstamo de Equipo"
              sequence="10"/>

    <!-- Submenú -->
    <menuitem id="menu_prestamo_equipos"
              name="Equipos"
              parent="menu_prestamo_root"
              action="action_prestamo_equipo"
              sequence="10"/>

</odoo>


